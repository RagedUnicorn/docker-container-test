{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RagedUnicorn/renovate-config"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the Container Structure Test version in the command test in sync with the Dockerfile ARG",
      "managerFilePatterns": [
        "/^test/container_test_command_test\\.yml$/"
      ],
      "matchStrings": [
        "expectedOutput: \\['(?<currentValue>\\d+\\.\\d+\\.\\d+)'\\]"
      ],
      "depNameTemplate": "GoogleContainerTools/container-structure-test",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Keep the Alpine version in the example command test in sync with the FROM version",
      "managerFilePatterns": [
        "/^test/example/alpine_command_test\\.yml$/"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "versioningTemplate": "docker",
      "matchStrings": [
        "args: \\['/etc/alpine-release'\\]\\s+exitCode: 0\\s+expectedOutput:\\s+- '(?<currentValue>[^']+)'"
      ]
    },
    {
      "customType": "regex",
      "description": "Keep the Alpine image in the test README example command in sync with the FROM version",
      "managerFilePatterns": [
        "/^test/README\\.md$/"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "versioningTemplate": "docker",
      "matchStrings": [
        "--image alpine:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 2
}
